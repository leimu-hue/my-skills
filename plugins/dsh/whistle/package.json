{
  "name": "@local/dsh-whistle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Whistle proxy tools for the agent: inspect captured HTTP/WebSocket traffic, read and write rule files and values, and check the proxy state — all through Whistle's Local Agent API, with no browser round-trip.",
  "exports": {
    ".": "./dist/host/index.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test",
    "test:only": "node --test",
    "typecheck:host": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
